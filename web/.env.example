# REQUIRED: session signing key. The app refuses to start without it in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# REQUIRED: admin bootstrap credentials. No defaults exist.
ADMIN_EMAIL=admin@cloudgameshop.com
ADMIN_PASSWORD=

# REQUIRED for gateway callbacks: public base URL of this deployment.
APP_BASE_URL=https://your-domain.example

# Number of trusted proxy hops (0 = direct). Needed for per-IP rate limiting behind a proxy.
TRUST_PROXY_COUNT=0

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Dominate Payment Gateway (KBZPay / WavePay real-time verification & payouts)
DOMINATE_GATEWAY_URL=https://pgw.flash-myanmar.com
DOMINATE_GATEWAY_API_KEY=dpk_live_xxxxxxxxxxxxxxxxxxxxxxxx
DOMINATE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# MLBB nickname lookup endpoint
# MLBB_VALIDASI_URL=https://htetgameshop.com/api/mlbb/validasi
# MLBB_REGIONCHECK_REFERER=https://htetgameshop.com/region-check

# Smile.one supplier (session shared with the Telegram bot; file is written mode 0600)
SMILE_REGION=br
SMILE_ORDER_URL=https://www.smile.one/br/customer/order
# Coolify: mount host /data/smileone and set:
SMILE_SESSION_PATH=/data/smileone/smileone_session.json
SMILE_TIMEOUT=30

# WathanPay Mini App SDK & Backend Verification
# Secret Key (SK) - Private: WathanPay App > Profile > Merchant Dashboard (e.g. wp_live_sk_...)
# REQUIRED for WathanPay login and payment verification. Without it, WathanPay login is disabled.
WATHANPAY_MERCHANT_SECRET=
WATHANPAY_API_KEY=

# Publishable Key (PK) - Public: WathanPay App > Profile > Merchant Dashboard (e.g. wp_live_pk_...)
NEXT_PUBLIC_WATHANPAY_PUBLISHABLE_KEY=

# WathanPay API URL (default: https://api.wathanpay.com)
WATHANPAY_API_URL=https://api.wathanpay.com

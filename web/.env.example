AUTH_SECRET=change-me-to-a-long-random-string

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Admin panel login (/admin/login) — set in Coolify / web/.env (not shown in the UI)
ADMIN_EMAIL=admin@cloudgameshop.com
ADMIN_PASSWORD=your_secure_password_here

# Dominate Payment Gateway (KBZPay / WavePay real-time verification & payouts)
DOMINATE_GATEWAY_URL=https://pgw.flash-myanmar.com
DOMINATE_GATEWAY_API_KEY=dpk_live_xxxxxxxxxxxxxxxxxxxxxxxx
DOMINATE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Optional: live MLBB nickname lookup. Demo nickname is used only if the lookup is unreachable.
# Set MLBB_DEMO_VERIFY=0 in production to require a live lookup.
# MLBB_DEMO_VERIFY=0

# Smile.one supplier (session shared with the Telegram bot)
SMILE_REGION=br
SMILE_ORDER_URL=https://www.smile.one/br/customer/order
# Coolify: mount host /data/smileone and set:
SMILE_SESSION_PATH=/data/smileone/smileone_session.json
SMILE_TIMEOUT=30

# WathanPay Mini App SDK & Backend Verification
# Secret Key (SK) - Private: WathanPay App > Profile > Merchant Dashboard (e.g. wp_live_sk_...)
# Used for server-to-server ledger verification (GET /v1/merchant/verify-payment) and HMAC-SHA256 authData verification
WATHANPAY_MERCHANT_SECRET=
WATHANPAY_API_KEY=

# Publishable Key (PK) - Public: WathanPay App > Profile > Merchant Dashboard (e.g. wp_live_pk_...)
NEXT_PUBLIC_WATHANPAY_PUBLISHABLE_KEY=

# WathanPay API URL (default: https://api.wathanpay.com)
WATHANPAY_API_URL=https://api.wathanpay.com

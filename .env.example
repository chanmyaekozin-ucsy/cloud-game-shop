# Smile.one region slug (br, id, my, etc.)
SMILE_REGION=br

# Request timeout in seconds
SMILE_TIMEOUT=30

# false = off-screen headed browser (local macOS). Use true in Docker/Coolify.
SMILE_REFRESH_HEADLESS=false

# Seconds to wait during automated OAuth (default 120)
SMILE_LOGIN_WAIT_SECONDS=120

# Use installed Google Chrome for OAuth on macOS. Leave empty in Docker/Coolify (Chromium).
SMILE_BROWSER_CHANNEL=chrome

# Page used to verify session / read balance
SMILE_ORDER_URL=https://www.smile.one/br/customer/order

# Shared Smile.one session (bot writes; web Supplier reads the same file)
# Coolify: sudo mkdir -p /data/smileone && mount /data/smileone on bot + web
SMILE_SESSION_PATH=/data/smileone/smileone_session.json

# Telegram bot (@cloud_gameshop_bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ADMIN_USERNAME=
# If Telegram API times out (common in MM), set a proxy e.g. socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=
TELEGRAM_CONNECT_TIMEOUT=60
TELEGRAM_READ_TIMEOUT=60

# KBZ Pay — READ-ONLY shared session (Payment Manager is the only writer)
# Coolify: KBZ_SESSION_PATH=/data/kbz/kbz_session.json  (+ mount /data/kbz)
# Shared used-tx ledger (default: same folder → kbz_claimed_txs.sqlite3)
# KBZ_CLAIMED_TX_PATH=/data/kbz/kbz_claimed_txs.sqlite3
KBZ_AUTO_VERIFY=true
KBZ_SESSION_PATH=.data/kbz_session.json
KBZ_MERCHANT_NAME=
KBZ_MERCHANT_PHONE=
KBZ_PAY_DISPLAY_NAME=
KBZ_PAY_PHONE=
KBZ_TX_EXAMPLE=82622
KBZ_SAMPLE_TX_IMAGE=data/sample_txid.jpg
PAYMENTS_PROOFS_GROUP_ID=
PAYMENT_TX_MAX_AGE_HOURS=2

# WavePay — READ-ONLY shared session (Payment Manager is the only writer)
# Coolify: WAVE_SESSION_PATH=/data/wave/wave_session.json  (+ mount /data/wave)
WAVE_AUTO_VERIFY=true
WAVE_SESSION_PATH=.data/wave_session.json
WAVE_MERCHANT_NAME=
WAVE_MERCHANT_PHONE=

# Shop payment ON/OFF catalog (Payment Manager writes; this shop reads)
# Coolify: SHOP_PAYMENT_ACCOUNTS_PATH=/data/payments/shop_payment_accounts.json (+ mount /data/payments)
SHOP_PAYMENT_ACCOUNTS_PATH=.data/shop_payment_accounts.json

# Dominate Payment Gateway (KBZPay / WavePay real-time verification & payouts)
DOMINATE_GATEWAY_URL=https://pgw.flash-myanmar.com
DOMINATE_GATEWAY_API_KEY=dpk_live_xxxxxxxxxxxxxxxxxxxxxxxx
DOMINATE_WEBHOOK_SECRET=your_webhook_signing_secret_here

WAVE_PAY_DISPLAY_NAME=
WAVE_PAY_PHONE=
# WAVE_TX_EXAMPLE=63265
# WAVE_SAMPLE_TX_IMAGE=data/sample_wave_txid.jpg
WAVE_TX_EXAMPLE=63265
WAVE_SAMPLE_TX_IMAGE=data/sample_wave_txid.jpg

# Smile Coin → MMK cost rate for admin Revenue (အရင်း = smile_coin × rate)
SMILE_COIN_KS_RATE=84.6

# Balance monitor — pins Smile.one coin balance in proofs group (random 40–120s)
# KBZ session/balance alerts: Donimate Payment Manager only (every 3600s)
MONITOR_ENABLED=true
MONITOR_INTERVAL_MIN_SEC=40
MONITOR_INTERVAL_MAX_SEC=120
# Do not set KBZ_FRIDA_LOG_PATH here — shop bots must not write the shared session
# KBZ_FRIDA_LOG_PATH=

# Database
SQLITE_PATH=.data/cloud_gameshop.sqlite3

# WathanPay Mini App SDK & Backend Verification
# Secret Key (SK) - Private: WathanPay App > Profile > Merchant Dashboard (e.g. wp_live_sk_...)
WATHANPAY_MERCHANT_SECRET=
WATHANPAY_API_KEY=
# Publishable Key (PK) - Public: WathanPay App > Profile > Merchant Dashboard (e.g. wp_live_pk_...)
NEXT_PUBLIC_WATHANPAY_PUBLISHABLE_KEY=
WATHANPAY_API_URL=https://api.wathanpay.com

GEMINI_KEY=
GEMINI_MODEL=Gemini 3.1 Flash Lite
